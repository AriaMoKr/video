  "description": "A WebXR room behind one of the Hallway's doors to watch old television in, together: public-domain shows from archive.org's Classic TV collection, in a video store, a den, a screening room or a gallery of each decade's sets. In VR, on a desktop, a phone or a TV.",
  "keywords": ["webxr", "virtual-reality", "threejs", "meta-quest", "video", "archive-org", "classic-tv"],
  "homepage": "https://ariamokr.github.io/video/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AriaMoKr/video.git"
  },
  "bugs": {
    "url": "https://github.com/AriaMoKr/video/issues"
  },
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node node_modules/common/tools/vendor.mjs",
    "start": "node tools/serve.mjs",
    "test": "node --test \"test/*.test.js\"",
    "types": "tsc -p tsconfig.json && tsc -p tsconfig.strict.json",
    "preview": "node tools/preview.mjs"
  },
  "dependencies": {
    "common": "github:AriaMoKr/common#v0.6.3",
